[Unit]
Description=KIZASHI failure prediction (inference and /metrics)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=kizashi
Group=kizashi
EnvironmentFile=-/etc/default/kizashi
ExecStart=/opt/kizashi/bin/kizashi serve --config /etc/kizashi/kizashi.yaml
Restart=on-failure
RestartSec=10s
StateDirectory=kizashi
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
